{
  "name": "ow-coach",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "portable": "node scripts/build_portable.mjs",
    "data:from-csv": "python3 scripts/csv_to_json.py",
    "grades:calibrate": "node --experimental-strip-types scripts/calibrate_grades.ts",
    "grades:check": "node --experimental-strip-types scripts/calibrate_grades.ts --check"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
